flowchart TD
    A["系统上电 / 初始化"] --> A1["初始化时钟、GPIO、ADC、RTC、PWM、串口、Flash、Watchdog"]
    A1 --> A2["校准参数 / 读取工厂参数 / 检查EEPROM"]
    A2 --> B["创建FreeRTOS任务"]

    B --> T1["Task1:采集与基础控制"]
    B --> T2["Task2:按键与输入事件处理"]
    B --> T3["Task3:气体监测与报警控制"]
    B --> T4["Task4:通信与模块消息处理"]

    T1 --> T1_1["串口接收：UART0/UART1/LPUART1"]
    T1_1 --> T1_2["日志接收处理"]
    T1_2 --> T1_3["气体传感器数据解析与校验"]
    T1_3 --> T1_4["按键扫描、LED状态、语音、阀门驱动、供电检测"]
    T1_4 --> T1_5["任务循环/周期10ms"]

    T2 --> T2_1["识别按键动作 / 长按 / 连击"]
    T2_1 --> T2_2["处理IR信号 / 阀门脉冲检测"]
    T2_2 --> T2_3["按键事件分发：报警静音、故障静音、测试"]
    T2_3 --> T2_4["任务循环/周期100ms"]

    T3 --> T3_1["预热阶段：灯光/语音提示 + 传感器预热"]
    T3_1 --> T3_2["周期检测：故障、报警、阀门状态、寿命判定"]
    T3_2 --> T3_3["气体故障判断与离线判断"]
    T3_3 --> T3_4["报警判定：浓度超阈值 / 故障状态 / 低电量/寿命"]
    T3_4 --> T3_5["执行输出：蜂鸣器、指示灯、阀门动作、显示更新"]
    T3_5 --> T3_6["任务循环/周期100ms"]

    T4 --> T4_1["组包PID、版本信息"]
    T4_1 --> T4_2["处理模块消息、上报/下发协议帧"]
    T4_2 --> T4_3["通信交互与功能状态同步"]

    T1_3 --> G1["气体采样数据：LEL、温度、故障码、校验和"]
    G1 --> G2["数值换算与状态更新"]
    G2 --> G3["更新 gas.value_lel / gas.value_fault / gas.value_temperature"]
    G3 --> T3_3

    T3_4 --> O1["报警输出"]
    T3_4 --> O2["故障输出"]
    T3_4 --> O3["阀门/语音/LED控制"]

    O1 --> P1["蜂鸣器报警 / 静音控制"]
    O2 --> P2["故障提示 / 错误记录 / 日志"]
    O3 --> P3["阀门开关 / 指示灯 / 设备状态显示"]

    P1 --> P4["日志记录 & 事件上报"]
    P2 --> P4
    P3 --> P4
    P4 --> END["产品运行状态：正常 / 报警 / 故障 / 预热 / 通信交互"]

    classDef app fill:#e8f1ff,stroke:#4a78c2,color:#1f2d3d;
    classDef service fill:#eaf7ea,stroke:#3d8b5d,color:#1f2d3d;
    classDef drive fill:#fff3e6,stroke:#d98c2a,color:#1f2d3d;
    classDef out fill:#fbe9f2,stroke:#b6547a,color:#1f2d3d;

    class A,A1,A2,B app;
    class T1,T2,T3,T4,T1_1,T1_2,T1_3,T1_4,T1_5,T2_1,T2_2,T2_3,T2_4,T3_1,T3_2,T3_3,T3_4,T3_5,T3_6,T4_1,T4_2,T4_3 service;
    class G1,G2,G3 drive;
    class O1,O2,O3,P1,P2,P3,P4,END out;
